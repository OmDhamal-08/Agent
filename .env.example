# Required database and AI configuration
DATABASE_URL=postgresql://user:password@host:5432/database
GEMINI_API_KEY=your_gemini_api_key

# Optional: Multiple Gemini API keys for rotation (comma-separated).
# When set, the system distributes requests across keys and automatically
# rotates to the next key if one hits its rate limit.
# GEMINI_API_KEYS=key_from_account1,key_from_account2,key_from_account3

# Razorpay test-mode credentials
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret

# Merchant dashboard security: generate long, unique values.
JWT_SECRET=replace_with_a_long_random_value
ADMIN_SIGNUP_CODE=replace_with_a_private_signup_code

# Optional. Defaults to localhost-only when omitted.
CORS_ALLOW_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
